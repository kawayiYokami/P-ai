{
  "name": "easy-call-ai",
  "private": true,
  "version": "0.90.0",
  "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8",
  "type": "module",
  "scripts": {
    "changelog:build": "node scripts/build-changelog.mjs",
    "clean:cargo-cache": "powershell -ExecutionPolicy Bypass -File scripts/clean-cargo-cache.ps1",
    "clean:cargo-cache:all": "powershell -ExecutionPolicy Bypass -File scripts/clean-cargo-cache.ps1 -All",
    "dev": "vite",
    "build": "tsc && vite build",
    "package:vscode-sidebar": "powershell -ExecutionPolicy Bypass -File scripts/package-vscode-sidebar.ps1",
    "publish:vscode-sidebar": "powershell -ExecutionPolicy Bypass -File scripts/publish-vscode-sidebar.ps1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "smoke": "powershell -ExecutionPolicy Bypass -File scripts/smoke.ps1",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:macos": "tauri build --target universal-apple-darwin --bundles app,dmg --config src-tauri/tauri.macos.conf.json"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@lucide/vue": "1.23.0",
    "@shikijs/stream": "^4.4.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@terrastruct/d2": "^0.1.33",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-js-cron/light": "^5.1.1",
    "cally": "^0.9.2",
    "chart.js": "^4.5.1",
    "cropperjs": "^2.1.1",
    "culori": "^4.0.2",
    "katex": "^0.17.0",
    "mermaid": "^11.16.0",
    "modern-screenshot": "^4.7.0",
    "shiki": "^4.3.1",
    "shiki-stream": "^0.1.5",
    "virtua": "^0.51.0",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6"
  },
  "devDependencies": {
    "@intlify/devtools-types": "^11.4.6",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "daisyui": "^5.7.9",
    "postcss": "8.5.16",
    "tailwindcss": "^4.3.2",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.6"
  }
